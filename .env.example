# OJa-WA Ubuntu development environment
# Copy to .env and replace local values as needed. Never commit .env.
RAILS_ENV=development
RACK_ENV=development
NODE_ENV=development

# Rails
RAILS_LOG_TO_STDOUT=true
RAILS_SERVE_STATIC_FILES=true
SECRET_KEY_BASE=replace-with-a-local-secret

# PostgreSQL
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=oja_wa
POSTGRES_PASSWORD=change-me
POSTGRES_DB=oja_wa_development
DATABASE_URL=postgresql://oja_wa:change-me@127.0.0.1:5432/oja_wa_development

# Redis
REDIS_URL=redis://127.0.0.1:6379/0

# Application
PORT=3000
HOST=127.0.0.1

# Payment/provider values are intentionally placeholders.
# Set real sandbox credentials only in the untracked .env.
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Optional terminal/runtime profile.
HERMES_ENV=ubuntu
HERMES_COMMAND=hermes
